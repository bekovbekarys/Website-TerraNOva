# Database
DATABASE_URL="file:./dev.db"

# Session signing secret — set this to a long random string in production
SESSION_SECRET="change-me-to-a-long-random-string"

# The email address that is granted moderator (admin) privileges automatically.
ADMIN_EMAIL="you@example.com"

# Directory where uploaded preprint PDFs are stored (relative to project root).
UPLOAD_DIR="./data/uploads"

# Public site URL (used for metadata and links in emails)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Email delivery (Resend, https://resend.com). If RESEND_API_KEY is unset,
# emails are logged to the server console instead of being sent.
RESEND_API_KEY=""
EMAIL_FROM="TerraNova <onboarding@resend.dev>"

# Spam protection (Cloudflare Turnstile, https://www.cloudflare.com/products/turnstile/).
# If these are unset, the CAPTCHA is disabled and forms still work.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
