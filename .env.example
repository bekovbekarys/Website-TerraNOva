# Database
DATABASE_URL="file:./dev.db"

# Session signing secret — set this to a long random string in production
SESSION_SECRET="change-me-to-a-long-random-string"

# The email address that is granted moderator (admin) privileges automatically.
ADMIN_EMAIL="you@example.com"

# Directory where uploaded preprint PDFs are stored (relative to project root).
UPLOAD_DIR="./data/uploads"

# Public site URL (used for metadata)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Zenodo (DOI minting) ---
# Personal access token with the "deposit:write" and "deposit:actions" scopes.
# Leave blank to disable DOI minting.
ZENODO_TOKEN=""
# The identifier (slug) of your Zenodo community.
ZENODO_COMMUNITY=""
# Production: https://zenodo.org/api  |  Sandbox: https://sandbox.zenodo.org/api
ZENODO_API_BASE="https://zenodo.org/api"
