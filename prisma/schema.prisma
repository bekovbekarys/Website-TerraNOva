generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  affiliation  String?
  orcid        String?
  passwordHash String
  role         String     @default("USER") // USER | ADMIN
  createdAt    DateTime   @default(now())

  preprints    Preprint[] @relation("AuthorSubmissions")
  reviewed     Preprint[] @relation("Moderator")
}

model Preprint {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  abstract       String
  authors        String   // free-text author list, e.g. "Jane Doe, John Smith"
  subject        String
  keywords       String?  // comma-separated
  license        String   @default("CC BY 4.0")
  comments       String?  // author comments (e.g. "12 pages, 4 figures")

  // File metadata
  fileOriginalName String
  fileStoredName   String   // name on disk, e.g. <id>.pdf
  fileMime         String
  fileSize         Int

  // Moderation
  status         String   @default("PENDING") // PENDING | PUBLISHED | REJECTED
  moderationNote String?
  version        Int      @default(1)

  // Demonstration data: sample preprints have placeholder PDFs and are not
  // viewable/downloadable. Real submissions leave this false.
  isSample       Boolean  @default(false)

  submittedBy    User     @relation("AuthorSubmissions", fields: [submittedById], references: [id], onDelete: Cascade)
  submittedById  String

  moderatedBy    User?    @relation("Moderator", fields: [moderatedById], references: [id])
  moderatedById  String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  publishedAt    DateTime?

  downloads      Int      @default(0)

  @@index([status])
  @@index([subject])
}
