# Database
DATABASE_URL="file:./dev.db"

# Session signing secret — CHANGE THIS in production to a long random string
SESSION_SECRET="terranova-dev-secret-change-me-to-a-long-random-string-please"

# The email address that is granted moderator (admin) privileges automatically.
ADMIN_EMAIL="tabekarys@gmail.com"

# Directory where uploaded preprint PDFs are stored (relative to project root).
UPLOAD_DIR="./data/uploads"

# Public site URL (used for metadata)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Zenodo (DOI minting) ---
# Personal access token from your Zenodo account (Applications > Personal access
# tokens) with the "deposit:write" and "deposit:actions" scopes. Leave blank to
# disable DOI minting. Use a SANDBOX token with the sandbox API base first.
ZENODO_TOKEN=""
# The identifier (slug) of your Zenodo community, e.g. "terranova".
ZENODO_COMMUNITY=""
# API base URL. Production: https://zenodo.org/api
# Sandbox (for testing, DOIs are not real): https://sandbox.zenodo.org/api
ZENODO_API_BASE="https://zenodo.org/api"
